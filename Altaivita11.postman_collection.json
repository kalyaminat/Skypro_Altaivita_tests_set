    {
      "name": "Просмотр корзины",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Content-Type is present\", function () {\r\n    pm.response.to.have.hem.response.text();\r\nconst productId = String(pm.collectionVariables.get(\"product_id\"));\r\nconst tags = html.match(/<div\\b[^>]*>/gi) || [];\r\n\r\nconst matchingTag = tags.find(tag => {\r\n    const match = tag.match(/\\bdata-item-product-id=[\"'](\\d+)[\"']/);\r\n    return match && match[1] === productId;\r\n});\r\n\r\nconst itemMatch = matchingTag\r\n    ? matchingTag.match(/\\bdata-item-id=[\"'](\\d+)[\"']/)\r\n    : null;\r\n\r\npm.collectionVariables.unset(\"itemID\");\r\n\r\npm.test(\"Найдена позиция выбранного товара\", function () {\r\n    pm.expect(\r\n        itemMatch,\r\n        `В корзине не найден товар ${productId}`\r\n    ).to.not.equal(null);\r\n});\r\n\r\nif (itemMatch) {\r\n    pm.collectionVariables.set(\"itemID\", itemMatch[1]);\r\n}"
            ]
          }
        }
      ],
